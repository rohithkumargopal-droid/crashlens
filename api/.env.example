# Local dev — on Zerops these are injected automatically via service references,
# e.g. DATABASE_URL=postgresql://${db_user}:${db_password}@${db_hostname}:5432/${db_dbName}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crashlens
REDIS_URL=redis://localhost:6379
PORT=3001

# Optional — postmortem/hint generation degrades gracefully to templated text without this
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
